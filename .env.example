# Copy to .env.local for Next.js, or .dev.vars for Wrangler.
# Never commit real secrets.

# Soft launch: set "true" locally to show banner / disable live checkout UX experiments.
# Production wrangler vars keep this false.
NEXT_PUBLIC_SOFT_LAUNCH=false
NEXT_PUBLIC_BILLING_DESCRIPTOR=ROOM23 WELLNESS

RESEND_API_KEY=
ADMIN_EMAIL=support@room23.net

# Optional CCBill FlexForms (hosted payment — card data never hits Room 23)
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUB_ACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_CURRENCY_CODE=840

ELDORADO_API_URL=
ELDORADO_API_KEY=
ELDORADO_ACCOUNT=
WILLIAMS_API_URL=
WILLIAMS_API_KEY=
WILLIAMS_ACCOUNT=
