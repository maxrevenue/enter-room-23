# Copy to .env.local for Next.js, or .dev.vars for Wrangler.
# Never commit real secrets.

# Storefront is live unless this is exactly "true".
# Set NEXT_PUBLIC_SOFT_LAUNCH=true locally to restore the banner and disable checkout UI.
NEXT_PUBLIC_SOFT_LAUNCH=false
NEXT_PUBLIC_BILLING_DESCRIPTOR=ROOM23 WELLNESS

# CORS for API routes only. Do not point this at a sister domain that is not live.
CORS_ORIGINS=https://room23.net

RESEND_API_KEY=
# Optional: defaults to support@room23.net
CONTACT_TO_EMAIL=support@room23.net
CONTACT_FROM_EMAIL=Room 23 <support@room23.net>

# One-time CCBill FlexForms (no recurring / rebill fields).
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUB_ACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_CURRENCY_CODE=840

# When "true", /api/checkout finalizes without a processor (local/staging only).
# Defaults to on when NODE_ENV is not production. Never show "coming soon" on the storefront.
CHECKOUT_MOCK=true

ELDORADO_API_URL=
ELDORADO_API_KEY=
ELDORADO_ACCOUNT=
WILLIAMS_API_URL=
WILLIAMS_API_KEY=
WILLIAMS_ACCOUNT=
