# Public storefront
NEXT_PUBLIC_SITE_URL=https://room23.net
NEXT_PUBLIC_BILLING_DESCRIPTOR=ROOM23 WELLNESS

# Browser API CORS (comma-separated). Default in code is https://room23.net
CORS_ORIGINS=https://room23.net

# Admin panel (httpOnly cookie gate). Set as a Wrangler secret in production.
ADMIN_PASSWORD=

# MongoDB (optional locally; required for order counts in /admin)
MONGODB_URI=

# Contact form — Resend (optional locally; /api/contact still accepts POST)
RESEND_API_KEY=
ADMIN_EMAIL=support@room23.net
CONTACT_TO_EMAIL=support@room23.net
CONTACT_FROM_EMAIL=Room 23 <hello@room23.net>

# CCBill FlexForms (one-time / non-recurring digest for hardware SKUs)
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUB_ACCOUNT=
CCBILL_ACCOUNT=
CCBILL_SUBACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_CURRENCY_CODE=840
# Staging/local only: skip FlexForms and send the shopper to /pay
CHECKOUT_MOCK=true

# Supplier integrations (server-only; never expose to the browser)
ELDORADO_API_KEY=
ELDORADO_API_SECRET=
WILLIAMS_TRADING_API_KEY=
WILLIAMS_TRADING_CUSTOMER_ID=
WILLIAMS_TRADING_PASSWORD=
WILLIAMS_TRADING_CUSTOMER_NUMBER=
WILLIAMS_TRADING_API_SECRET=
