{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "room23-dark-theme",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "room23-dark-theme"
    }
  ],

  "vars": {
    "ADMIN_EMAIL": "support@room23.net",
    "BIZ_ADDRESS_STREET": "5482 Wilshire Blvd #333",
    "BIZ_ADDRESS_CITY_STATE": "Los Angeles, CA 90036",
    "BIZ_PHONE": "(425) 505-3528",
        "SITE_INDEXABLE": "true",
        "CORS_ORIGINS": "https://room23.net",
        "NEXT_PUBLIC_SITE_URL": "https://room23.net",
        "NEXT_PUBLIC_BILLING_DESCRIPTOR": "ROOM23 WELLNESS"
  },

  // ── Staging environment ──
  // Deploy with: npx wrangler deploy --env staging
  // Secrets (RESEND_API_KEY, ADMIN_PASSWORD, MONGODB_URI) must be set separately:
  //   npx wrangler secret put ADMIN_PASSWORD
  //   npx wrangler secret put MONGODB_URI
  //   npx wrangler secret put RESEND_API_KEY
  // Never store secrets in this file.
  "env": {
    "staging": {
      "name": "enter-room-23-staging",
      "main": ".open-next/worker.js",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "NEXT_PUBLIC_DEPLOYMENT_ENV": "staging"
      }
    },
    "preview": {
      "name": "enter-room-23-preview",
      "main": ".open-next/worker.js",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "NEXT_PUBLIC_DEPLOYMENT_ENV": "production"
      }
    }
  },

  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
